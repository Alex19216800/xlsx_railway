{
  "name": "hr-portal-api",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only API for the Ovoprime HR portal",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
